# Gemini API（ユーザー自身が取得したキーを記入）
# https://aistudio.google.com/ などで取得
GEMINI_API_KEY=

# モデル名（時点の正式IDに合わせて変更可）
GEMINI_MODEL_FLASH=gemini-3.5-flash
GEMINI_MODEL_FLASH_LITE=gemini-3.5-flash-lite

# Chrome CDP
CDP_HOST=127.0.0.1
CDP_PORT=9222

# ブラウザプロファイル（ログイン状態の維持用・相対パス可）
USER_DATA_DIR=user-data

# Chrome 実行ファイル（空なら自動検出。必要ならフルパス）
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# 終了時にブラウザを残す（ログイン維持）。閉じたい場合は false または --close-browser
KEEP_BROWSER_OPEN=true

# 観察候補の上限（Gemini に渡す要素数）
OBSERVE_MAX_CANDIDATES=40

# 実行エンジン
MAX_STEPS=30
POST_ACTION_WAIT_MS=500
MAX_CONSECUTIVE_FAILURES=2
REPLAN_ON_FAILURE=true

# 収集モード（true だと click/type/select をブロック）
COLLECT_MODE=false

# ログ
LOG_LEVEL=INFO
